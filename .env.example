APP_ENV=development
APP_PORT=8080

DATABASE_URL=postgres://mediadock:mediadock_dev_password@localhost:5432/mediadock?sslmode=disable
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

STORAGE_TYPE=local
STORAGE_PATH=./storage_data
LOCAL_SIGNING_SECRET=change-this-signing-secret-in-production

S3_BUCKET=mediadock-media
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

MAX_FILE_SIZE=524288000
MAX_PROCESSING_TIME=300s
JOB_RETENTION_TTL=24h
HISTORY_RETENTION_DAYS=90
WORKER_CONCURRENCY=4
JOB_MAX_RETRIES=3

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

INSTAGRAM_GRAPH_API_BASE=https://graph.instagram.com
INSTAGRAM_APP_ID=
INSTAGRAM_ACCESS_TOKEN=

